{
  "$schema": "../exact/scripts/app.schema.json",
  "name": "Miwa",
  "short_name": "Miwa",
  "id": "com.ib.miwa",
  "start_url": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay"
  ],
  "app": {
    "id": "com.ib.miwa",
    "name": "Miwa"
  },
  "host": {
    "macos": {
      "minimumOS": "14.0",
      "icon": "assets/miwa-icon/Miwa.icon",
      "window": {
        "width": 1100,
        "height": 760,
        "keepRunning": true
      }
    }
  },
  "deploy": {
    "store": {
      "macos": "0"
    }
  }
}
