+    content
+  }
+#else
+  @State private var editMode: EditMode = .inactive
+
+  func body(content: Content) -> some View {
+    content
+      .onAppear {
+        editMode = enabled ? .active : .inactive
+      }
+      .onChange(of: enabled) { newValue in
+        withAnimation {
+          editMode = newValue ? .active : .inactive
